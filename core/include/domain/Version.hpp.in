/**
 * @file Version.hpp.in
 * @brief CMake template for compile-time application versioning and Git commit SHA tracking.
 */

#pragma once

#include <cstdint>
#include <string_view>

namespace grow::domain
{

    /**
     * @struct SystemVersion
     * @brief Semantic version metadata injected by CMake build system.
     */
    struct SystemVersion
    {
        static constexpr std::uint16_t kMajor = @PROJECT_VERSION_MAJOR@; ///< Major semantic version component.
        static constexpr std::uint16_t kMinor = @PROJECT_VERSION_MINOR@; ///< Minor semantic version component.
        static constexpr std::uint16_t kPatch = @PROJECT_VERSION_PATCH@; ///< Patch semantic version component.

        static constexpr std::string_view kVersionString = "@PROJECT_VERSION@";                     ///< Formatted version string (e.g. "0.1.0").
        static constexpr std::string_view kGitCommitHash = "@GIT_COMMIT_HASH@";                     ///< Git commit SHA recorded at build configuration.
        static constexpr std::string_view kFullBuildTag = "v@PROJECT_VERSION@+@GIT_COMMIT_HASH@"; ///< Full release and commit identifier tag.
    };

} // namespace grow::domain
